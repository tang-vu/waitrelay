# Optional OpenAI-compatible provider. These values are read on the server only.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=

# Set to 1 only when a visibly labeled fixture fallback is acceptable.
ALLOW_FIXTURE_FALLBACK=0

# disabled is the safe default. demo is a labeled sandbox preview.
# commons must remain unavailable until an official public contract is verified.
PAYMENTS_MODE=disabled
