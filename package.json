{
  "name": "waitrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A playable decision relay that turns AI waiting time into meaningful human input.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --port 4317",
    "build": "next build",
    "start": "next start --port 4317",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:race": "vitest run tests/race",
    "test:privacy": "vitest run tests/privacy",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:ops": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/ops/deploy-local.test.ps1",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/deploy-local.ps1",
    "demo:preflight": "playwright test tests/e2e/demo-smoke.spec.ts --project=chromium --repeat-each=3",
    "demo:capture": "node ops/capture-demo.mjs",
    "demo:record": "node ops/record-demo.mjs",
    "host:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/hosting-preflight.ps1"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
